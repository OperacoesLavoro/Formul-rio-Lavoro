{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "formulario-lavoro",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "DATAJUD_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
